# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# Data: exclude raw/local data by default
data/
*.7z
*.csv
*.csv.gz
*.parquet

# Allow only the dashboard's synthetic demo exports
!data/
data/*
!data/tableau/
data/tableau/*
!data/tableau/*.csv

# Local warehouse and synthetic test outputs
warehouse/
results/_SYNTHETIC_TEST_ONLY/
tests/fixtures/generated/

# dbt artefacts
dbt/streampulse/target/
dbt/streampulse/logs/
dbt/streampulse/dbt_packages/
dbt/streampulse/.user.yml
logs/

# Credentials: never committed
kaggle.json
*.json.key
service-account*.json
.env
profiles.yml
